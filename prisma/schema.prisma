// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECH
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model User {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  password        String
  role            Role            @default(TECH)
  createdAt       DateTime        @default(now())
  jobsCreated     Job[]           @relation("JobCreatedBy")
  laborEntries    LaborEntry[]
  materialEntries MaterialEntry[]
  purchaseOrders  PurchaseOrder[]
}

model Job {
  id              String          @id @default(cuid())
  jobNumber       String
  scopeOfWork     String
  customerName    String
  customerContact String
  location        String
  status          JobStatus       @default(OPEN)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       User            @relation("JobCreatedBy", fields: [createdById], references: [id])
  createdById     String
  laborEntries    LaborEntry[]
  materialEntries MaterialEntry[]
  purchaseOrders  PurchaseOrder[]
}

model LaborEntry {
  id          String   @id @default(cuid())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  date        DateTime
  hours       Float
  description String?
  createdAt   DateTime @default(now())
}

model MaterialEntry {
  id          String   @id @default(cuid())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  date        DateTime @default(now())
  description String
  quantity    Float    @default(1)
  unitCost    Float?
  createdAt   DateTime @default(now())
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  poNumber    String
  vendor      String
  description String?
  amount      Float?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

// A customer site, with the details worth knowing before you show up:
// service info, device/finish colors, and lists of panels and lighting.
model Customer {
  id               String    @id @default(cuid())
  name             String
  phone            String?
  email            String?
  address          String
  // Service
  utilityCompany   String?
  meterNumber      String?
  serviceType      String?
  // Devices & finishes
  deviceBrand      String?
  deviceStyle      String?
  outletColor      String?
  switchColor      String?
  coverPlateColor  String?
  coverPlateType   String?
  accessNotes      String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  panels           Panel[]
  fixtures         Fixture[]
}

model Panel {
  id          String   @id @default(cuid())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId  String
  label       String
  location    String?
  brand       String?
  amperage    Int?
  panelType   String?
  voltage     String?
  spaces      Int?
  breakerType String?
  notes       String?
  createdAt   DateTime @default(now())
}

model Fixture {
  id          String   @id @default(cuid())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId  String
  location    String
  fixtureType String?
  quantity    Int?
  lampType    String?
  ballast     String?
  notes       String?
  createdAt   DateTime @default(now())
}
