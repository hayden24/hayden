// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECH
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model User {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  password        String
  role            Role            @default(TECH)
  createdAt       DateTime        @default(now())
  jobsCreated     Job[]           @relation("JobCreatedBy")
  laborEntries    LaborEntry[]
  materialEntries MaterialEntry[]
  purchaseOrders  PurchaseOrder[]
}

model Job {
  id              String          @id @default(cuid())
  jobNumber       String
  scopeOfWork     String
  customerName    String
  customerContact String
  location        String
  status          JobStatus       @default(OPEN)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       User            @relation("JobCreatedBy", fields: [createdById], references: [id])
  createdById     String
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId      String?
  laborEntries    LaborEntry[]
  materialEntries MaterialEntry[]
  purchaseOrders  PurchaseOrder[]
}

model LaborEntry {
  id          String   @id @default(cuid())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  date        DateTime
  hours       Float
  description String?
  createdAt   DateTime @default(now())
}

model MaterialEntry {
  id          String   @id @default(cuid())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  date        DateTime @default(now())
  description String
  quantity    Float    @default(1)
  unitCost    Float?
  createdAt   DateTime @default(now())
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  poNumber    String
  vendor      String
  description String?
  amount      Float?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Customer {
  id        String              @id @default(cuid())
  name      String
  contact   String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  jobs      Job[]
  services  ElectricalService[]
  fixtures  LightingFixture[]
  circuits  Circuit[]
  infoItems CustomerInfoItem[]
}

// A service entrance / main panel at the customer's property.
model ElectricalService {
  id           String   @id @default(cuid())
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId   String
  location     String?
  amperage     String?
  voltage      String?
  phase        String?
  panelBrand   String?
  panelModel   String?
  utilityMeter String?
  notes        String?
  createdAt    DateTime @default(now())
}

model LightingFixture {
  id           String   @id @default(cuid())
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId   String
  area         String?
  fixtureType  String?
  lampType     String?
  ballastBrand String?
  ballastModel String?
  quantity     String?
  notes        String?
  createdAt    DateTime @default(now())
}

model Circuit {
  id            String   @id @default(cuid())
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  description   String?
  fedFrom       String?
  circuitNumber String?
  breakerSize   String?
  wireSize      String?
  notes         String?
  createdAt     DateTime @default(now())
}

// Free-form label/value pairs for anything that doesn't have its own section yet.
model CustomerInfoItem {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  label      String?
  value      String?
  createdAt  DateTime @default(now())
}
